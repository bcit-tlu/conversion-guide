# Normalize real text files automatically
* text=auto eol=lf

# Binary assets - never line-ending normalize these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf

*.mp4 binary
*.mov binary
*.webm binary

*.pdf binary
*.psd binary

*.docx binary
*.xlsx binary
*.pptx binary